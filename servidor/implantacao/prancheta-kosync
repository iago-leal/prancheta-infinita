#!/bin/bash
# Usuários do progresso de leitura do KOReader, pelo protocolo KOSync. Roda
# como administrador na VPS; instalado pelo roteiro preparar-vps.sh em
# /usr/local/sbin.
#
#   prancheta-kosync novo <usuário>      cria o usuário e mostra a senha uma única vez
#   prancheta-kosync listar              lista os usuários
#   prancheta-kosync revogar <usuário>   apaga o usuário; o progresso gravado fica
#
# A senha tem 20 letras minúsculas e algarismos, sem separadores, para ser
# digitada uma vez no KOReader, em Sincronização de progresso, junto com o
# usuário. O KOReader envia ao servidor o resumo MD5 da senha, e o servidor
# guarda só o resumo SHA-256 desse resumo, em /etc/prancheta/acesso/kosync;
# o arquivo é relido quando muda, e um usuário novo ou revogado vale na hora,
# sem reiniciar. Essa credencial só abre o progresso de leitura: não vale para
# os quadros, os arquivos nem a biblioteca.

set -euo pipefail
umask 027

ARQUIVO="${PRANCHETA_KOSYNC:-/etc/prancheta/acesso/kosync}"

falhar() {
  echo "$1" >&2
  exit "${2:-1}"
}

nome_valido() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || falhar "nome invalido: use letras, numeros, ponto, hifen ou sublinhado" 2
}

tem() {
  awk -v nome="$1" '$1 == nome { achou = 1 } END { exit !achou }' "$ARQUIVO"
}

[[ -f "$ARQUIVO" ]] || falhar "arquivo de usuarios do KOSync inexistente: $ARQUIVO; rode o roteiro preparar-vps.sh"

case "${1:-}" in
  novo)
    (( $# == 2 )) || falhar "uso: prancheta-kosync novo <usuario>" 2
    nome_valido "$2"
    if tem "$2"; then falhar "o usuario $2 ja existe; revogue-o antes de criar outro"; fi
    senha="$(head -c 12 /dev/urandom | base32 | tr 'A-Z' 'a-z' | tr -d '=\n')"
    (( ${#senha} == 20 )) || falhar "nao foi possivel criar a senha"
    chave="$(printf '%s' "$senha" | md5sum | cut -d' ' -f1)"
    resumo="$(printf '%s' "$chave" | sha256sum | cut -d' ' -f1)"
    printf '%s %s\n' "$2" "$resumo" >> "$ARQUIVO"
    echo "Usuário $2 do KOSync. A senha é mostrada só agora; digite-a uma vez no KOReader:"
    echo "$senha"
    ;;
  listar)
    (( $# == 1 )) || falhar "uso: prancheta-kosync listar" 2
    awk '!/^#/ && NF == 2 { print $1 }' "$ARQUIVO"
    ;;
  revogar)
    (( $# == 2 )) || falhar "uso: prancheta-kosync revogar <usuario>" 2
    nome_valido "$2"
    tem "$2" || falhar "o usuario $2 nao existe"
    novo="$(mktemp "$ARQUIVO.XXXXXX")"
    awk -v nome="$2" '$1 != nome' "$ARQUIVO" > "$novo"
    chown --reference="$ARQUIVO" "$novo"
    chmod --reference="$ARQUIVO" "$novo"
    mv -f "$novo" "$ARQUIVO"
    echo "usuario $2 do KOSync revogado"
    ;;
  *)
    falhar "uso: prancheta-kosync novo <usuario> | listar | revogar <usuario>" 2
    ;;
esac
